# Porta da API
PORT=3001

# Conexão com o PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bm_producao
# Use DATABASE_SSL=true em provedores que exigem SSL (Render, Neon, Supabase...)
DATABASE_SSL=false

# Segredo do JWT — use uma string longa e aleatória
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=7d

# Origens permitidas para o front-end (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# Fotos: Supabase Storage (Project Settings > API Keys > Secret key).
# Bucket público "fotos" (criado pelo npm run migrate quando o banco é o Supabase).
# Sem nenhum storage configurado, as fotos ficam em backend/uploads (modo teste).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=fotos

# Alternativa ao Supabase Storage: Cloudinary (opcional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bm-producao

# Tamanho máximo de cada foto (MB)
MAX_IMAGE_MB=10

# Primeiro admin (usado pelo "npm run seed")
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
